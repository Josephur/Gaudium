# The shape headers (issue #7): every kernel object is rebuilt when one changes (coarse, but a stale ELF would be a wrong-shape kernel).
$(KERNEL_OBJS): $(TPC_SRC)/gdn_shape.h $(TPC_SRC)/attn_shape.h

# ---- shape variants (issue #7): the head-count parameterised kernels rebuilt for other model shapes -------------------------------
# One entry per shape: <tag>:<a>:<b>. The tag names the objects (<stem>_<tag>_gaudi2.o); env.sh exports GAUDIUM_<K>_<TAG>_ELF for the
# same list (keep the two lists in step) and the glue picks the variable from the node's tensor shapes.
#   GDN_SHAPES  k<HK>r<REP>:<HK>:<REP>    linear attention: HK key heads, REP value heads per key head
#   ATT_SHAPES  g<NKV>q<GQ>:<NKV>:<GQ>    full attention: NKV kv groups of GQ query heads
# k16r2 + g2q8 = Qwen3.6-35B-A3B (16 key / 32 value heads; 16 query heads in 2 kv groups). g2q12 = Qwen3.8-Flash-Next (24 query heads in 2 kv groups).
GDN_SHAPES := k16r2:16:2
ATT_SHAPES := g2q8:2:8 g2q12:2:12
# <object stem>:<source>:<variant flags, joined by +>
GDN_VARIANT_KERNELS := gdn_prep:gdn_prep_gaudi2.c: gdn_preps:gdn_prep_gaudi2.c:-DSLOT gdn_prepd:gdn_prep_dec_gaudi2.c: gdn_prepsd:gdn_prep_dec_gaudi2.c:-DSLOT \
  gdn_prept:gdn_prep_dec_gaudi2.c:-DTREE gdn_prep2:gdn_prep2_gaudi2.c: gdn_prep2s:gdn_prep2_gaudi2.c:-DSLOT gdn_prepa:gdn_prepa_gaudi2.c: gdn_prepb:gdn_prepb_gaudi2.c: \
  gdn_post:gdn_post_gaudi2.c: gdn_postd:gdn_post_gaudi2.c:-DDECODE gdn_post2:gdn_post2_gaudi2.c: gdn_postb:gdn_postb_gaudi2.c:
ATT_VARIANT_KERNELS := attn_prep:attn_prep_gaudi2.c: attn_prepf:attn_prep_gaudi2.c:-DFRESH attn_prept:attn_prep_gaudi2.c:-DTREE attn_prep8:attn_prep_gaudi2.c:-DKV8 \
  attn_prepf8:attn_prep_gaudi2.c:-DKV8+-DFRESH attn_prept8:attn_prep_gaudi2.c:-DKV8+-DTREE attn_post:attn_post_gaudi2.c: attn_post_f32:attn_post_f32_gaudi2.c: \
  attn_softmax:attn_softmax_gaudi2.c: kv_commit:kv_commit_gaudi2.c: kv_commit8:kv_commit_gaudi2.c:-DKV8
# $(1) object stem, $(2) source, $(3) variant flags (+ separated), $(4) shape tag, $(5) the shape's -D flags
define SHAPE_VARIANT_RULE
$$(KDIR)/$(1)_$(4)_gaudi2.o: $$(TPC_SRC)/$(2) $$(TPC_SRC)/gdn_shape.h $$(TPC_SRC)/attn_shape.h | $$(KDIR)
	cd $$(TPC_SRC) && $$(TPC_CC) -march=gaudi2 -O2 $(subst +, ,$(3)) $(5) -x c++ -c $(2) -o $$@
KERNEL_OBJS += $$(KDIR)/$(1)_$(4)_gaudi2.o
KERNEL_ASMS += $$(KDIR)/$(1)_$(4)_gaudi2.asm
endef
$(foreach sh,$(GDN_SHAPES),$(foreach k,$(GDN_VARIANT_KERNELS),$(eval $(call SHAPE_VARIANT_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))),$(word 1,$(subst :, ,$(sh))),-DGDN_HK=$(word 2,$(subst :, ,$(sh))) -DGDN_REP=$(word 3,$(subst :, ,$(sh)))))))
# qwen4_exp (Qwen3.8-Flash-Next): the gated DeltaNet output gate is sigmoid(z), not silu(z): the post kernels again with -DGATE_SIGMOID,
# tag <shape>s (the glue picks it from node flag bit 10). Qwen3.8-Flash-Next has the 27B's 16 key / 48 value heads.
GDN_SIG_SHAPES := k16r3s:16:3
GDN_SIG_KERNELS := gdn_post:gdn_post_gaudi2.c:-DGATE_SIGMOID gdn_postd:gdn_post_gaudi2.c:-DDECODE+-DGATE_SIGMOID gdn_post2:gdn_post2_gaudi2.c:-DGATE_SIGMOID gdn_postb:gdn_postb_gaudi2.c:-DGATE_SIGMOID
$(foreach sh,$(GDN_SIG_SHAPES),$(foreach k,$(GDN_SIG_KERNELS),$(eval $(call SHAPE_VARIANT_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))),$(word 1,$(subst :, ,$(sh))),-DGDN_HK=$(word 2,$(subst :, ,$(sh))) -DGDN_REP=$(word 3,$(subst :, ,$(sh)))))))
$(foreach sh,$(ATT_SHAPES),$(foreach k,$(ATT_VARIANT_KERNELS),$(eval $(call SHAPE_VARIANT_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))),$(word 1,$(subst :, ,$(sh))),-DATT_NKV=$(word 2,$(subst :, ,$(sh))) -DATT_GQ=$(word 3,$(subst :, ,$(sh)))))))

# ---- 128-channel attention heads (plain Qwen3: Qwen3-8B; GUIDs gaudium_attn128_*): attn_shape.h with ATT_DH=128 (one 128-lane row per
# head, full RoPE, no output gate). ATT128_SHAPES <tag>:<NKV>:<GQ> builds prep / tree prep / post per head-count shape (env.sh exports
# GAUDIUM_A128<K>_<TAG>_ELF: keep the two lists in step); the combine depends on the head width only (two builds). bf16 KV only.
ATT128_SHAPES := g8q4:8:4
ATT128_VARIANT_KERNELS := attn128_prep:attn_prep_gaudi2.c: attn128_prept:attn_prep_gaudi2.c:-DTREE attn128_post:attn_post_f32_gaudi2.c:
$(foreach sh,$(ATT128_SHAPES),$(foreach k,$(ATT128_VARIANT_KERNELS),$(eval $(call SHAPE_VARIANT_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))),$(word 1,$(subst :, ,$(sh))),-DATT_DH=128 -DATT_NKV=$(word 2,$(subst :, ,$(sh))) -DATT_GQ=$(word 3,$(subst :, ,$(sh)))))))
$(KDIR)/attn128_combine_gaudi2.o: $(TPC_SRC)/attn_combine_gaudi2.c $(TPC_SRC)/attn_shape.h | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -DATT_DH=128 -x c++ -c $(notdir $<) -o $@
$(KDIR)/attn128_combinex_gaudi2.o: $(TPC_SRC)/attn_combine_gaudi2.c $(TPC_SRC)/attn_shape.h | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -DATT_DH=128 -DUNROLL -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/attn128_combine_gaudi2.o $(KDIR)/attn128_combinex_gaudi2.o
KERNEL_ASMS += $(KDIR)/attn128_combine_gaudi2.asm $(KDIR)/attn128_combinex_gaudi2.asm
# plain-weight fused add + RMSNorm (Qwen3RMSNorm: w * bf16(normalised), two roundings), gaudium_fused_add_norm node param 1 = 1
$(KDIR)/add_normp_gaudi2.o: $(TPC_SRC)/add_norm_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -DPLAIN_W -x c++ -c $(notdir $<) -o $@
