# ---- qwen4_exp (Qwen3.8-Flash-Next): hyper-connections and the n-gram (PLE) layer ----
Q4X_KERNELS := hc_norm hc_mix hc_combine ple_gate ple_conv ple_sync
define Q4X_RULE
$$(KDIR)/$(1)_gaudi2.o: $$(TPC_SRC)/$(1)_gaudi2.c | $$(KDIR)
	cd $$(TPC_SRC) && $$(TPC_CC) -march=gaudi2 -O2 -x c++ -c $(1)_gaudi2.c -o $$@
KERNEL_OBJS += $$(KDIR)/$(1)_gaudi2.o
