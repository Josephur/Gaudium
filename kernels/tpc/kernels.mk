endef
$(foreach k,$(Q4X_KERNELS),$(eval $(call Q4X_RULE,$(k))))
# ---- QSA (Qwen3.8-Flash-Next sparse attention, docs/notes/engine-qsa.md) ----
# -fno-reroll-loops: tpc-clang re-rolls hand-unrolled loops by default (qsa_select: 4 count chains back into one latency-bound chain)
QSA_KERNELS := qsa_prep:qsa_prep_gaudi2.c: qsa_prepf:qsa_prep_gaudi2.c:-DFRESH qsa_commit:qsa_prep_gaudi2.c:-DCOMMIT \
  qsa_score:qsa_score_gaudi2.c:-fno-reroll-loops qsa_select:qsa_select_gaudi2.c:-fno-reroll-loops \
  attn_softmax_chunkq:attn_softmax_chunk_gaudi2.c:-DQSA attn_softmax_chunkxq:attn_softmax_chunk_gaudi2.c:-DFASTEXP+-DQSA \
  attn_softmax_chunkx4q:attn_softmax_chunk_gaudi2.c:-DFASTEXP+-DSTAGE+-DUSE_EXP4+-DQSA \
  attn_softmax_chunk8q:attn_softmax_chunk_gaudi2.c:-DKV8+-DQSA attn_softmax_chunkx8q:attn_softmax_chunk_gaudi2.c:-DKV8+-DFASTEXP+-DQSA \
  qsa_selectb:qsa_select_gaudi2.c:-fno-reroll-loops+-DBITMAP qsa_gather:qsa_gather_gaudi2.c: qsa_sp_softmax:qsa_sp_softmax_gaudi2.c: \
  qsa_sp_out:qsa_sp_out_gaudi2.c: qsa_sp_outd:qsa_sp_out_gaudi2.c:-DDENSE0
define QSA_RULE
$$(KDIR)/$(1)_gaudi2.o: $$(TPC_SRC)/$(2) | $$(KDIR)
	cd $$(TPC_SRC) && $$(TPC_CC) -march=gaudi2 -O2 $(subst +, ,$(3)) -x c++ -c $(2) -o $$@
KERNEL_OBJS += $$(KDIR)/$(1)_gaudi2.o
KERNEL_ASMS += $$(KDIR)/$(1)_gaudi2.asm
endef
$(foreach k,$(QSA_KERNELS),$(eval $(call QSA_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))))))
# ---- Gemma 4 (docs/notes/engine-gemma4.md): attention kernels that take the head counts and widths as scalars (one ELF for every
# size of the family), the combine per head width (4 / 8 f32 vectors: 256 / 512 channels), the GELU MLP product, the logit soft cap ----
GA_KERNELS := ga_prep:ga_prep_gaudi2.c: ga_prepk:ga_prep_gaudi2.c:-DKEQV ga_softmax_ring:ga_softmax_ring_gaudi2.c: \
  ga_combine4:ga_combine_gaudi2.c:-DGA_NV2=4 ga_combine8:ga_combine_gaudi2.c:-DGA_NV2=8 ga_post:ga_post_gaudi2.c: \
  ga_gelu:ga_gelu_gaudi2.c: ga_softcap:ga_softcap_gaudi2.c: ga_qprep:ga_qprep_gaudi2.c: \
  ga_prepv:ga_prep_gaudi2.c:-DVRAW ga_kv:ga_kv_gaudi2.c: ga_softmax_ringx:ga_softmax_ring_gaudi2.c:-DEXT ga_copy:ga_copy_gaudi2.c: ga_clamp:ga_clamp_gaudi2.c: \
  ga_relattn:ga_relattn_gaudi2.c: ga_act:ga_act_gaudi2.c: ga_dwconv:ga_dwconv_gaudi2.c: ga_lnrelu:ga_lnrelu_gaudi2.c: ga_argmax:ga_argmax_gaudi2.c: ga_lnorm:ga_lnorm_gaudi2.c: ga_rmsnorm:ga_rmsnorm_gaudi2.c:
$(foreach k,$(GA_KERNELS),$(eval $(call QSA_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))))))
# W4L / W8 routed experts (feature/flash-next-moe, docs/notes/moe-w4l.md): no FMA contraction (the host twin reproduces every f32 op)
W4_DEPS := $(TPC_SRC)/moe_w4_common.h $(TPC_SRC)/moe_w4_mv_body.h
$(KDIR)/moe_w4_plan_gaudi2.o: $(TPC_SRC)/moe_w4_plan_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_q8_gaudi2.o: $(TPC_SRC)/moe_w4_q8_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_gu_gaudi2.o: $(TPC_SRC)/moe_w4_mv_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DGU -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_gu8_gaudi2.o: $(TPC_SRC)/moe_w4_mv_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DGU -DW8 -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_dn_gaudi2.o: $(TPC_SRC)/moe_w4_mv_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_dn8_gaudi2.o: $(TPC_SRC)/moe_w4_mv_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DW8 -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_comb_gaudi2.o: $(TPC_SRC)/moe_w4_comb_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_comba_gaudi2.o: $(TPC_SRC)/moe_w4_comb_gaudi2.c $(W4_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DADD -x c++ -c $(notdir $<) -o $@
# the miss gate of a hybrid layer in a decode step (expert cache, docs/notes/moe-expert-cache.md); -DFIRST: no running totals in
$(KDIR)/moe_w4_gate_gaudi2.o: $(TPC_SRC)/moe_w4_gate_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_w4_gate0_gaudi2.o: $(TPC_SRC)/moe_w4_gate_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -DFIRST -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/moe_w4_gate_gaudi2.o $(KDIR)/moe_w4_gate0_gaudi2.o
KERNEL_ASMS += $(KDIR)/moe_w4_gate_gaudi2.asm $(KDIR)/moe_w4_gate0_gaudi2.asm
KERNEL_OBJS += $(KDIR)/moe_w4_plan_gaudi2.o $(KDIR)/moe_w4_q8_gaudi2.o $(KDIR)/moe_w4_comb_gaudi2.o $(KDIR)/moe_w4_comba_gaudi2.o
W4_MV_OBJS := $(KDIR)/moe_w4_gu_gaudi2.o $(KDIR)/moe_w4_gu8_gaudi2.o $(KDIR)/moe_w4_dn_gaudi2.o $(KDIR)/moe_w4_dn8_gaudi2.o
KERNEL_OBJS += $(W4_MV_OBJS)
# MME prefill path of the routed experts (feature/flash-next-prefill, docs/notes/flash-next-prefill.md)
MME_DEPS := $(TPC_SRC)/moe_w4_common.h
$(KDIR)/moe_mdq13_gaudi2.o: $(TPC_SRC)/moe_mme_dq_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DGU -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_mdq13w8_gaudi2.o: $(TPC_SRC)/moe_mme_dq_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DGU -DW8 -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_mdq2_gaudi2.o: $(TPC_SRC)/moe_mme_dq_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_mdq2w8_gaudi2.o: $(TPC_SRC)/moe_mme_dq_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DW8 -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_mswiglu_gaudi2.o: $(TPC_SRC)/moe_mme_sw_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_mgather_gaudi2.o: $(TPC_SRC)/moe_mme_gc_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -DGATHER -x c++ -c $(notdir $<) -o $@
$(KDIR)/moe_mcomb_gaudi2.o: $(TPC_SRC)/moe_mme_gc_gaudi2.c $(MME_DEPS) | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/moe_mdq13_gaudi2.o $(KDIR)/moe_mdq13w8_gaudi2.o $(KDIR)/moe_mdq2_gaudi2.o $(KDIR)/moe_mdq2w8_gaudi2.o $(KDIR)/moe_mswiglu_gaudi2.o $(KDIR)/moe_mgather_gaudi2.o $(KDIR)/moe_mcomb_gaudi2.o

# step kernels added after the first kernel set, with their own glue plugin (libgaudium_st.so beside libgaudium_tpc.so in
# GC_KERNEL_PATH, so that library stays the same binary and recipes without these kernels keep their recipe-cache keys)
# gdn_f32r: the verify-row recurrence without per-row state checkpoints (the accepted rows' updates are applied again by the next step)
$(KDIR)/gdn_f32r_gaudi2.o: $(TPC_SRC)/gdn_f32r_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/gdn_f32r_gaudi2.o
# gdn_f32v: the slotted row recurrence with its per-row gate scalars as vector loads (bit-identical to gdn_f32s)
$(KDIR)/gdn_f32v_gaudi2.o: $(TPC_SRC)/gdn_f32v_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/gdn_f32v_gaudi2.o
# ds_ctxr / ds_softr: a block drafter's context as rings of its sliding window (cost independent of the engine's context size)
$(KDIR)/ds_ctxr_gaudi2.o: $(TPC_SRC)/ds_ctxr_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/ds_ctxr_gaudi2.o
$(KDIR)/ds_softr_gaudi2.o: $(TPC_SRC)/ds_softr_gaudi2.c | $(KDIR)
	cd $(TPC_SRC) && $(TPC_CC) -march=gaudi2 -O2 -x c++ -c $(notdir $<) -o $@
KERNEL_OBJS += $(KDIR)/ds_softr_gaudi2.o
$(KDIR)/libgaudium_st.so: $(GLUE_SRC)/st_glue.cpp $(GLUE_SRC)/elf_record.inc | $(KDIR)
	$(CXX) -O2 -std=c++17 -fPIC -shared -I$(HABANA_INC) $< -o $@

# ---- Inkling 2 (looped MoE decoder without rotary positions): block-residual mix, message gates, short convolutions with their
# position rings, clipped / position-scaled queries, biased softmax with a sink, sigmoid router, soft-capped expert activation.
# Their glue is libgaudium_ik.so, a plugin of its own beside the other glue libraries.
IK_KERNELS := ik_mix:ik_mix_gaudi2.c: ik_mixf:ik_mix_gaudi2.c:-DPF32 ik_gin:ik_gin_gaudi2.c: ik_mgate:ik_mgate_gaudi2.c: ik_mgatef:ik_mgate_gaudi2.c:-DFG_F32 \
  ik_norm:ik_norm_gaudi2.c: ik_save:ik_save_gaudi2.c: ik_conva:ik_conv_gaudi2.c: ik_convm:ik_conv_gaudi2.c:-DMLP ik_qprep:ik_qprep_gaudi2.c: \
  ik_kvprep:ik_kvprep_gaudi2.c: ik_softmax:ik_softmax_gaudi2.c: ik_combine:ik_combine_gaudi2.c: ik_route:ik_route_gaudi2.c: ik_moe_act:ik_moe_act_gaudi2.c: \
  ik_argmax:ik_argmax_gaudi2.c:
# $(1) object stem, $(2) source, $(3) variant flags
define IK_RULE
$$(KDIR)/$(1)_gaudi2.o: $$(TPC_SRC)/$(2) $$(TPC_SRC)/ik_common.h | $$(KDIR)
	cd $$(TPC_SRC) && $$(TPC_CC) -march=gaudi2 -O2 $(3) -x c++ -c $(2) -o $$@
KERNEL_OBJS += $$(KDIR)/$(1)_gaudi2.o
endef
$(foreach k,$(IK_KERNELS),$(eval $(call IK_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))))))
# The Inkling 2 block drafter (mtp.safetensors): context mixes, context / block heads with rotary positions, a two-set softmax over the
# context state and the block, the merge, a plain SwiGLU, the recurrent head's step and its arg-max. Same glue library.
IKD_KERNELS := ik_dmix:ik_dmix_gaudi2.c: ik_dkv:ik_dkv_gaudi2.c: ik_dqprep:ik_dqprep_gaudi2.c: ik_dsoft:ik_dsoft_gaudi2.c: \
  ik_dcomb:ik_dcomb_gaudi2.c: ik_dswiglu:ik_dswiglu_gaudi2.c: ik_mstep:ik_mstep_gaudi2.c: ik_margmax:ik_margmax_gaudi2.c:
define IKD_RULE
$$(KDIR)/$(1)_gaudi2.o: $$(TPC_SRC)/$(2) $$(TPC_SRC)/ik_common.h $$(TPC_SRC)/ik_mtp.h | $$(KDIR)
	cd $$(TPC_SRC) && $$(TPC_CC) -march=gaudi2 -O2 $(3) -x c++ -c $(2) -o $$@
KERNEL_OBJS += $$(KDIR)/$(1)_gaudi2.o
endef
$(foreach k,$(IKD_KERNELS),$(eval $(call IKD_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))))))
# Inkling 2 routed experts & on-card softcap/sampler kernels (build with -ffp-contract=off for exact FTZ+DAZ matching)
IK_MV_DEPS := $(TPC_SRC)/moe_w4_common.h $(TPC_SRC)/ik_w4_mv_body.h
IK_FAST_KERNELS := ik_route_r:ik_route_r_gaudi2.c: ik_w4_plan:ik_w4_plan_gaudi2.c: \
  ik_w4_q8:ik_w4_q8_gaudi2.c: ik_w8_q8:ik_w4_q8_gaudi2.c:-DBLK32 \
  ik_w4_gu:ik_w4_mv_gaudi2.c:-DGU ik_w4_dn:ik_w4_mv_gaudi2.c: \
  ik_w8_gu:ik_w4_mv_gaudi2.c:-DGU+-DW8 ik_w8_dn:ik_w4_mv_gaudi2.c:-DW8 \
  ik_w4_comb:ik_w4_comb_gaudi2.c: ik_softcap:ik_softcap_gaudi2.c: ik_mcap:ik_mcap_gaudi2.c:
define IK_FAST_RULE
$$(KDIR)/$(1)_gaudi2.o: $$(TPC_SRC)/$(2) $$(TPC_SRC)/ik_common.h $$(IK_MV_DEPS) | $$(KDIR)
	cd $$(TPC_SRC) && $$(TPC_CC) -march=gaudi2 -O2 -ffp-contract=off $(subst +, ,$(3)) -x c++ -c $(2) -o $$@
KERNEL_OBJS += $$(KDIR)/$(1)_gaudi2.o
endef
$(foreach k,$(IK_FAST_KERNELS),$(eval $(call IK_FAST_RULE,$(word 1,$(subst :, ,$(k))),$(word 2,$(subst :, ,$(k))),$(word 3,$(subst :, ,$(k))))))
$(KDIR)/libgaudium_ik.so: $(GLUE_SRC)/ik_glue.cpp $(GLUE_SRC)/elf_record.inc | $(KDIR)
	$(CXX) -O2 -std=c++17 -fPIC -shared -I$(HABANA_INC) $< -o $@
